FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "pcorr.*"
    {
        solver          GAMG;
        tolerance       1e-2;
        relTol          0;
        smoother        DICGaussSeidel;
        cacheAgglomeration no;
        maxIter         50;
    }

    p
    {
        $pcorr;
        tolerance       1e-6;
        relTol          0.01;
    }

    pFinal
    {
        $p;
        tolerance       1e-6;
        relTol          0;
    }

    "(U|k|epsilon|e|nuTilda|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-6;
        relTol          0.1;
    }

    "(U|k|epsilon|e|nuTilda|omega)Final"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-6;
        relTol          0;
    }
}

PIMPLE
{
    momentumPredictor   yes;
    nOuterCorrectors    4;
    nCorrectors     2;
    nNonOrthogonalCorrectors 2;
	
	residualControl
	{
		p
		{
			tolerance  1e-5;
			relTol     0;
		}
		
		U
		{
			tolerance  1e-5;
			relTol     0;
		}
		
		"(k|omega|e|epsilon)"
		{
			tolerance  1e-5;
			relTol     0;
		}
	}
}

potentialFlow
{
    nNonOrthogonalCorrectors 1;
}

cache
{
    grad(U);
}


